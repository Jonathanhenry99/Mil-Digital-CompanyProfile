# Copy to .env.local and fill in. See docs/PROJECT_SPEC.md §9.

# Neon Postgres (pooled, -pooler host) and direct (unpooled) connection strings
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Random 32+ byte string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
